#!ipxe

#Harvester - Advanced PXE Boot Script with Full Configuration and Defaults

#--- 1. Initial Network Setup (VLAN 2013) A ---

# echo "-------------------------------------------------------------------"
# echo "Setting up VLAN 2013 on net0 and attempting DHCP..."
# vcreate --tag 2013 net0

# dhcp net0-2013 || goto net_fail_2013

#--- 1. Initial Network Setup (VLAN 2014) B ---

echo "-------------------------------------------------------------------"
echo "Setting up VLAN 2014 on net0 and attempting DHCP..."
vcreate --tag 2014 net0

dhcp net0-2014 || goto net_fail_2014

goto set_harvester_defaults

# :net_fail_2013
# echo "-------------------------------------------------------------------"
# echo "ERROR: DHCP failed on VLAN 2013 (net0-2013). Check network setup."
# echo "-------------------------------------------------------------------"
# prompt --timeout 15000 Press [Enter] to drop to iPXE Shell || reboot
# shell
# reboot

:net_fail_2014
echo "-------------------------------------------------------------------"
echo "ERROR: DHCP failed on VLAN 2014 (net0-2014). Check network setup."
echo "-------------------------------------------------------------------"
prompt --timeout 15000 Press [Enter] to drop to iPXE Shell || reboot
shell
reboot

#--- 2. Set ALL Harvester Kernel Parameter Defaults ---

:set_harvester_defaults

#General/Required Settings (User must set these in the menu)

set harvester_desired_version v1.7.0
set harvester_artifact_server http://10.115.1.6/iso
set harvester_configuration_url http://10.115.1.6/iso/config/airgap-create.yaml

#OS / Host Configuration Defaults

set h_token t
set h_scheme_ver 1
set h_os_pass t
set h_hostname airgap-node
set h_modules kvm,nvme
set h_ntp 10.115.2.116
set h_dns 10.115.1.70
set h_sftp true

#Network Configuration Defaults

set h_vip_mode static
set h_vip 10.115.16.217/32
set h_mgmt_if_name eno49
set h_mgmt_bond_mode active-backup
set h_mgmt_method static
set h_mgmt_ip 10.115.16.117/21
set h_mgmt_mask 255.255.248.0
set h_mgmt_gw 10.115.15.254
set h_mgmt_vlan:int32 2013

#Install Configuration Defaults

set h_auto true
set h_mode create
set h_install_dev /dev/nvme0n1
set h_data_disk /dev/nvme0n1
set h_skip_checks true
set h_wipe_list /dev/nvme0n1

goto harvester

#--- 3. Harvester Main Menu Logic ---

:harvester
set os HarvesterGeneric
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch amd64 ||

menu ${os} - ${os_arch} - Configuration Menu
item --gap "-------------------------------------------------------------------"
item config_general Set Harvester Version, Config URL, Fileserver URL (Required)
# item config_network Set Network Configuration (${h_mgmt_ip})
# item config_os_host Set OS and Hostname (${h_hostname})
# item config_install Set Installation and Disk (${h_install_dev})
item --gap "-------------------------------------------------------------------"
item harvester_boot_check Start Harvester Installation
item harvester_exit Exit iPXE (continue to next boot device)

#SET TIMEOUT: Defaults to harvester_exit after 30 seconds (30000ms)

choose --timeout 30000 --default harvester_exit menu || goto harvester
echo ${cls}

#Execute the chosen menu item by jumping to its label

goto ${menu}

#--- 4. Sub-Menu Definitions ---

:config_general
menu General Configuration
item set_version ${space} Harvester Version: ${harvester_desired_version}
item set_url ${space} Fileserver URL: ${harvester_artifact_server}
item set_config_url ${space} Harvester Configuration URL: ${harvester_configuration_url}
item --key x back_to_main Return to Main Menu
choose menu || goto harvester
goto ${menu}

# :config_os_host
# menu OS/Host Configuration
# item set_hostname ${space} Hostname: ${h_hostname}
# item set_os_pass ${space} OS Password: ${h_os_pass}
# item set_token ${space} Cluster Token: ${h_token}
# item set_scheme_ver ${space} Scheme Version: ${h_scheme_ver}
# item set_modules ${space} OS Modules: ${h_modules}
# item set_ntp ${space} NTP Servers: ${h_ntp}
# item set_dns ${space} DNS Nameserver: ${h_dns}
# item set_sftp ${space} Enable SFTP: ${h_sftp}
# item --key x back_to_main Return to Main Menu
# choose menu || goto harvester
# goto ${menu}

# :config_network
# menu Network Configuration
# item set_mgmt_if_name ${space} Management NIC: ${h_mgmt_if_name}
# item set_mgmt_bond_mode ${space} Bond Mode: ${h_mgmt_bond_mode}
# item set_mgmt_method ${space} Mgmt IP Method: ${h_mgmt_method}
# item set_mgmt_ip ${space} Mgmt IP/CIDR: ${h_mgmt_ip}
# item set_mgmt_mask ${space} Mgmt Subnet Mask: ${h_mgmt_mask}
# item set_mgmt_gw ${space} Mgmt Gateway: ${h_mgmt_gw}
# item set_mgmt_vlan ${space} Mgmt VLAN ID: ${h_mgmt_vlan}
# item set_vip_mode ${space} VIP Mode: ${h_vip_mode}
# item set_vip ${space} VIP Address/Mask: ${h_vip}
# item --key x back_to_main Return to Main Menu
# choose menu || goto harvester
# goto ${menu}

# :config_install
# menu Installation and Disk Configuration
# item set_auto ${space} Automatic Install: ${h_auto}
# item set_mode ${space} Install Mode: ${h_mode}
# item set_install_dev ${space} Install Device: ${h_install_dev}
# item set_data_disk ${space} Data Disk: ${h_data_disk}
# item set_wipe_list ${space} Wipe Disks List: ${h_wipe_list}
# item set_skip_checks ${space} Skip Checks: ${h_skip_checks}
# item --key x back_to_main Return to Main Menu
# choose menu || goto harvester
# goto ${menu}

:back_to_main
clear menu
goto harvester

#--- 5. Input Labels (Set Value or use Default) ---

#Pattern for all inputs: read input_value, if not empty, set the variable.

:set_version
echo -n Set desired Harvester Version (e.g., v1.3.0) (Default: ${harvester_desired_version}): && read input_value
iseq ${input_value} "" || set harvester_desired_version ${input_value}
clear menu
goto config_general

:set_url
echo -n Set the Harvester Fileserver URL (Default: ${harvester_artifact_server}): && read input_value
iseq ${input_value} "" || set harvester_artifact_server ${input_value}
clear menu
goto config_general

:set_config_url
echo -n Set the Harvester Configuration URL (Default: ${harvester_configuration_url}): && read input_value
iseq ${input_value} "" || set harvester_configuration_url ${input_value}
clear menu
goto config_general

