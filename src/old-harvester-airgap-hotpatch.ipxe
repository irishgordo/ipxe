#--- 6. Boot Logic (Constructing final params) ---

:harvester_boot_check

#Final check for required fields

sub iseq ${harvester_desired_version} "" && echo -n ERROR: Harvester Version is required! && sleep 3 && goto harvester ||
sub iseq ${harvester_artifact_server} "" && echo -n ERROR: Fileserver URL is required! && sleep 3 && goto harvester ||
sub iseq ${harvester_configuration_url} "" && echo -n ERROR: Harvester Configuration URL is required! && sleep 3 && goto harvester ||
goto harvester_boot

:harvester_boot

#1. CONSTRUCT INSTALL_PARAMS (All 22 variables)

#FIX: Corrected multiline variable assignment to ensure proper concatenation.
# harvester.install.managementInterface.vlanId=${h_mgmt_vlan} -> it can't work, currently: https://github.com/harvester/harvester/issues/9667
# harvester.install.skipChecks=${h_skip_checks} -> it can't work, currently: https://github.com/harvester/harvester/issues/9667
# harvester.schemeVersion=${h_scheme_ver} -> it can't work, currently: https://github.com/harvester/harvester/issues/9667
# harvester.token=${h_token} harvester.os.password=${h_os_pass}
#harvester.os.hostname=${h_hostname} harvester.os.modules=${h_modules} harvester.os.ntpServers=${h_ntp} harvester.os.dnsNameservers=${h_dns} harvester.os.sshd.sftp=${h_sftp} harvester.install.mode=${h_mode} harvester.install.vipMode=${h_vip_mode} harvester.install.vip=${h_vip} harvester.install.managementInterface.interfaces[0].name=${h_mgmt_if_name} harvester.install.interfacesStringHackName=${h_mgmt_if_name} harvester.install.managementInterface.bondOptions.mode=${h_mgmt_bond_mode} harvester.install.managementInterface.method=${h_mgmt_method} harvester.install.managementInterface.ip=${h_mgmt_ip} harvester.install.managementInterface.subnetMask=${h_mgmt_mask} harvester.install.managementInterface.gateway=${h_mgmt_gw} harvester.install.device=${h_install_dev} harvester.install.dataDisk=${h_data_disk} harvester.install.managementInterface.vlanIdString=${h_mgmt_vlan} harvester.install.wipeDisksList=${h_wipe_list}
set install_params harvester.install.iso_url=${harvester_artifact_server}/${harvester_desired_version}/harvester-${harvester_desired_version}-amd64.iso harvester.install.config_url=${harvester_configuration_url} harvester.install.automatic=true

set console_setting console=tty1
iseq ${h_auto} false && set console_setting console=tty1 console=ttyS0 ||
#2. CONSTRUCT BOOT_PARAMS

#NOTE: Removed conflicting network parameters from the kernel command line.
#vlan=vlan2014:eno49 ip=vlan2014:dhcp
# /2009-04-04/user-data ifname=netboot:8c:dc:d4:b5:ca:98  vlan=vlan2021:netboot
# vlan=vlan2013:eno49 ip=vlan2013:dhcp
# net0-2013
# ifname=net0-2013 ip=net0-2013:dhcp vlan=2013:net0
# vlan=2013:eno49 ip=vlan2013:dhcp
set boot_params net.ifnames=1 vlan=vlan2014:eno49 ip=vlan2014:dhcp ${console_setting} rd.cos.disable root=live:${harvester_artifact_server}/${harvester_desired_version}/harvester-${harvester_desired_version}-rootfs-amd64.squashfs rd.noverifyssl intel_iommu=on amd_iommu=on iommu=pt

#3. KERNEL & INITRD LOAD

kernel ${harvester_artifact_server}/${harvester_desired_version}/harvester-${harvester_desired_version}-vmlinuz-amd64 ${install_params} ${boot_params}
initrd ${harvester_artifact_server}/${harvester_desired_version}/harvester-${harvester_desired_version}-initrd-amd64
echo
boot

:harvester_exit
clear menu
exit 0